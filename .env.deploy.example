# Copy this file to .env.deploy and fill in real server credentials.
# .env.deploy is ignored by git.

# Choose exactly one topology:
#   single: one master node, graceful restart without peer traffic draining.
#   multi: primary + standby, peer traffic draining and standby-first rollout.
DEPLOY_TOPOLOGY=multi

# Primary server configuration is shared by both topologies. In single mode,
# only these connection/runtime fields are required and this is the only node.
DEPLOY_PRIMARY_HOST=your.primary.server.ip
DEPLOY_PRIMARY_PORT=22
DEPLOY_PRIMARY_USER=root
DEPLOY_PRIMARY_PASSWORD=your_primary_ssh_password
# DEPLOY_PRIMARY_SSH_KEY=/absolute/path/to/primary/private/key
DEPLOY_PRIMARY_APP_ENV_FILE=.env.production-primary
DEPLOY_PRIMARY_NODE_TYPE=master

# Multi-machine-only routing fields for the primary server. They may be omitted
# in single mode.
DEPLOY_PRIMARY_WIREGUARD_UPSTREAM=10.38.145.1:3000
DEPLOY_PRIMARY_CADDY_PROXY_SNIPPETS=primary_proxy,distributed_proxy

# Standby server configuration is required only in multi mode. The standby
# slave is updated first; the primary master is updated last.
DEPLOY_STANDBY_HOST=your.standby.server.ip
DEPLOY_STANDBY_PORT=22
DEPLOY_STANDBY_USER=root
DEPLOY_STANDBY_PASSWORD=your_standby_ssh_password
# DEPLOY_STANDBY_SSH_KEY=/absolute/path/to/standby/private/key
DEPLOY_STANDBY_APP_ENV_FILE=.env.production-standby
DEPLOY_STANDBY_NODE_TYPE=slave
DEPLOY_STANDBY_WIREGUARD_UPSTREAM=10.38.145.2:3000
DEPLOY_STANDBY_CADDY_PROXY_SNIPPETS=common_proxy

DEPLOY_REMOTE_DIR=/www/wwwroot/modelsell
DEPLOY_SERVICE_NAME=modelsell
DEPLOY_BINARY_NAME=new-api
DEPLOY_APP_PORT=3000

# Build target. linux + amd64 is the Go name for Linux x86_64.
DEPLOY_GOOS=linux
DEPLOY_GOARCH=amd64
DEPLOY_GOAMD64=v1
DEPLOY_ARCH_LABEL=x86_64

# The selected server's DEPLOY_*_APP_ENV_FILE is uploaded to
# DEPLOY_REMOTE_DIR/.env. Keep NODE_TYPE=master in the primary file and
# NODE_TYPE=slave in the standby file.

# Safer release deployment settings.
# The service starts from DEPLOY_REMOTE_DIR/current/new-api. Each deploy extracts
# into DEPLOY_REMOTE_DIR/releases/<release-id>, switches current, then checks
# http://127.0.0.1:${DEPLOY_APP_PORT}${DEPLOY_HEALTH_PATH}. If startup or health
# check fails, the script restores the previous current release and .env.
DEPLOY_HEALTH_PATH=/api/ready
DEPLOY_HEALTH_TIMEOUT=180
DEPLOY_KEEP_RELEASES=5

# Validate indexability against the local origin after restart. A failed SEO
# check triggers the same automatic release rollback as a failed health check.
DEPLOY_SEO_VERIFY=true
DEPLOY_SEO_CANONICAL_URL=https://modelsell.com

# Deployment behavior. "auto" enables peer draining in multi mode and disables
# it in single mode. The multi rolling command builds once and updates standby
# first, then primary. Each selected multi-mode node sends new requests to its
# healthy peer before SIGTERM; the old process gets up to 900s
# to finish in-flight streams. Only after stable readiness and smoke checks does
# the script restore the node's exact original Caddy routing. On any uncertain
# failure, traffic remains on the healthy peer.
DEPLOY_ZERO_DOWNTIME=auto
DEPLOY_CADDY_CONFIG=/etc/caddy/Caddyfile
DEPLOY_CADDY_HEALTH_HOST=modelsell.com
DEPLOY_DRAIN_HEALTH_PATH=/api/ready
# Port 3000 is publicly reachable in the current topology. During a rollout,
# temporary iptables DNAT sends new direct connections to the WireGuard peer;
# existing local connections finish before the old process receives SIGTERM.
DEPLOY_DIRECT_PORT_DRAIN=true
# If the public interface has a global IPv6 address, Caddy temporarily listens
# on this auxiliary port and ip6tables redirects new IPv6 :3000 connections to
# the selected node's WireGuard peer. Existing IPv6 connections keep draining.
DEPLOY_DIRECT_IPV6_DRAIN=true
DEPLOY_IPV6_DRAIN_PROXY_PORT=39002
DEPLOY_PUBLIC_INTERFACE=auto
DEPLOY_WIREGUARD_INTERFACE=wg0
DEPLOY_TRAFFIC_SETTLE_SECONDS=3
DEPLOY_PEER_STABLE_CHECKS=5
DEPLOY_POST_START_STABLE_CHECKS=5
# Keep traffic on the healthy peer while the new process proves that its PID,
# restart counter, readiness endpoint, and dependencies remain stable.
DEPLOY_POST_START_SOAK_SECONDS=15
DEPLOY_SHUTDOWN_TIMEOUT=900
DEPLOY_STOP_TIMEOUT=930
DEPLOY_SMOKE_TESTS=true
DEPLOY_STREAM_LOGS=false

# Run without arguments to choose from:
# 1) build + upload + config
# 2) build only
# 3) upload existing build only
# 4) update runtime config only
#
# Non-interactive examples:
# ./scripts/deploy-modelsell.sh --full
# ./scripts/deploy-modelsell.sh --build-only
# ./scripts/deploy-modelsell.sh --upload-only
# ./scripts/deploy-modelsell.sh --config-only
# ./scripts/deploy-modelsell.sh --config-check
# Single-machine full release:
# DEPLOY_TOPOLOGY=single ./scripts/deploy-modelsell.sh --full
# Multi-machine rolling release:
# ./scripts/deploy-modelsell.sh --rolling-full
# DEPLOY_TARGET=primary ./scripts/deploy-modelsell.sh --zero-downtime-test
# DEPLOY_TARGET=standby ./scripts/deploy-modelsell.sh --zero-downtime-test
