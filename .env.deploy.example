# Copy this file to .env.deploy and fill in real server credentials.
# .env.deploy is ignored by git.

DEPLOY_HOST=your.server.ip
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=your_ssh_password

DEPLOY_REMOTE_DIR=/www/wwwroot/modelsell
DEPLOY_SERVICE_NAME=modelsell
DEPLOY_BINARY_NAME=new-api
DEPLOY_APP_PORT=3000
DEPLOY_STANDBY_APP_PORT=3001

# Build target. linux + amd64 is the Go name for Linux x86_64.
DEPLOY_GOOS=linux
DEPLOY_GOARCH=amd64
DEPLOY_GOAMD64=v1
DEPLOY_ARCH_LABEL=x86_64

# Local runtime env file that will be uploaded to DEPLOY_REMOTE_DIR/.env.
DEPLOY_APP_ENV_FILE=.env.production

# Safer release deployment settings.
# By default the script uses zero-downtime blue/green cutover. It starts the new
# release on DEPLOY_STANDBY_APP_PORT, checks it, reloads Caddy to point at the new
# port, then waits for the previous slot to drain before stopping it. If startup,
# health check, or Caddy reload fails, current traffic keeps using the old slot.
DEPLOY_ZERO_DOWNTIME=true
DEPLOY_HEALTH_PATH=/api/status
DEPLOY_HEALTH_TIMEOUT=30
DEPLOY_KEEP_RELEASES=5
DEPLOY_DRAIN_TIMEOUT=900

# The production Caddyfile must import this file at the site route where
# ModelSell traffic should be proxied, for example:
# import /etc/caddy/modelsell-upstream.caddy
DEPLOY_CADDY_UPSTREAM_FILE=/etc/caddy/modelsell-upstream.caddy
DEPLOY_CADDY_CONFIG_FILE=/etc/caddy/Caddyfile

# Run without arguments to choose from:
# 1) build + upload + config
# 2) build only
# 3) upload existing build only
# 4) update runtime config only
#
# Non-interactive examples:
# ./scripts/deploy-modelsell.sh --full
# ./scripts/deploy-modelsell.sh --build-only
# ./scripts/deploy-modelsell.sh --upload-only
# ./scripts/deploy-modelsell.sh --config-only

# Optional. If set, the script uses this SSH key instead of DEPLOY_PASSWORD.
# DEPLOY_SSH_KEY=/Users/you/.ssh/id_rsa
