# Pin a tested release in production. Change this only during an upgrade.
APIMETER_API_IMAGE=wagjie/apimeter-api:apimeter-2026.08.05

# Safe production default: expose the application only to a local reverse proxy.
# Change to 0.0.0.0 explicitly only for temporary direct HTTP/IP access.
APIMETER_BIND_IP=127.0.0.1
APIMETER_API_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=apimeter-docker-1

# Existing MySQL database. The host must be reachable from the container.
# For MySQL on the Docker host, use host.docker.internal rather than 127.0.0.1.
SQL_DSN=user:password@tcp(host.docker.internal:3306)/existing_database?charset=utf8mb4&parseTime=true&loc=Local
# Leave empty to store logs in the same existing MySQL database.
LOG_SQL_DSN=

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
# Reuse the historical SESSION_SECRET to preserve existing login sessions.
SESSION_SECRET=
# If the old deployment did not set CRYPTO_SECRET, use its SESSION_SECRET here.
CRYPTO_SECRET=

# For direct HTTP/IP access, keep these values as shown.
# For HTTPS, set true and provide every trusted public URL, comma-separated.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
FRONTEND_BASE_URL=

# Conservative defaults for one application container and one MySQL container.
SQL_MAX_OPEN_CONNS=100
SQL_MAX_IDLE_CONNS=25
SQL_MAX_LIFETIME=60
REDIS_POOL_SIZE=20
MEMORY_CACHE_ENABLED=true
ERROR_LOG_ENABLED=true
SYNC_FREQUENCY=60
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
STREAMING_TIMEOUT=300
