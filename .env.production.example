# Copy this file to .env.production and fill in the server runtime config.
# .env.production is ignored by git and will be uploaded as /www/wwwroot/modelsell/.env.

PORT=3000
GIN_MODE=release
TZ=Asia/Shanghai
NODE_TYPE=master
# Give every application node a unique, stable name for logs and metrics.
NODE_NAME=modelsell-primary
SQL_MAX_OPEN_CONNS=150
SQL_MAX_IDLE_CONNS=50
SQL_MAX_LIFETIME=60

# Public site URL. Example: https://modelsell.example.com
FRONTEND_BASE_URL=

# Agent custom domains should CNAME to <verify-token>.<AGENT_CNAME_BASE_DOMAIN>.
# Example: agent-cname.example.com
AGENT_CNAME_BASE_DOMAIN=

# Caddy On-Demand TLS ask secret. Use it in the ask URL as ?secret=<value>.
AGENT_TLS_ASK_SECRET=

# MySQL example:
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/modelsell?charset=utf8mb4&parseTime=true&loc=Local
SQL_DSN=

# Optional: use a separate log database. Leave empty to reuse SQL_DSN.
# LOG_SQL_DSN=

# Redis examples:
# REDIS_CONN_STRING=redis://:password@127.0.0.1:6379/0
# REDIS_CONN_STRING=redis://127.0.0.1:6379/0
REDIS_CONN_STRING=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Recommended production defaults.
MEMORY_CACHE_ENABLED=true
ERROR_LOG_ENABLED=true
SYNC_FREQUENCY=60
CHANNEL_UPDATE_FREQUENCY=30
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=300

# Temporary image storage. Used to convert uploaded images into URLs that upstream providers can fetch.
# API_TEMP_IMAGE_STORAGE options: auto, local, oss. auto uses OSS when all OSS fields are filled.
API_TEMP_IMAGE_STORAGE=auto

# Local fallback storage.
API_TEMP_IMAGE_DIR=
API_TEMP_IMAGE_PUBLIC_BASE_URL=

# Aliyun OSS temporary image storage.
API_TEMP_IMAGE_OSS_ENDPOINT=
API_TEMP_IMAGE_OSS_BUCKET=
API_TEMP_IMAGE_OSS_ACCESS_KEY_ID=
API_TEMP_IMAGE_OSS_ACCESS_KEY_SECRET=
API_TEMP_IMAGE_OSS_PREFIX=relay-temp-images
# Optional CDN/public base URL. If empty, the service returns a signed OSS temporary URL.
API_TEMP_IMAGE_OSS_PUBLIC_BASE_URL=
API_TEMP_IMAGE_OSS_SIGNED_URL_EXPIRE_SECONDS=86400
