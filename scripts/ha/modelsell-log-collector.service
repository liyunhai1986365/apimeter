[Unit]
Description=ModelSell logs to standby OpenObserve
After=network-online.target wg-quick@wg0.service modelsell.service caddy.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/modelsell-log-collector/collector.py
Restart=always
RestartSec=5
User=root
WorkingDirectory=/opt/modelsell-log-collector
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
