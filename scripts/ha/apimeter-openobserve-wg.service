[Unit]
Description=APIMeter OpenObserve private WireGuard proxy
Requires=apimeter-openobserve-wg.socket
After=docker.service apimeter-openobserve-wg.socket

[Service]
ExecStart=/lib/systemd/systemd-socket-proxyd 127.0.0.1:5080
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
