# Pin a tested release in production. Change this only during an upgrade.
MODELSELL_API_IMAGE=wagjie/modelsell-api:modelsell-2026.08.05

# Use 127.0.0.1 when an HTTPS reverse proxy runs on this server.
MODELSELL_BIND_IP=0.0.0.0
MODELSELL_API_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=modelsell-docker-1

# Generate every value independently with: openssl rand -hex 32
# Hex values avoid URL escaping problems in SQL_DSN and REDIS_CONN_STRING.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

# For direct HTTP/IP access, keep these values as shown.
# For HTTPS, set true and provide every trusted public URL, comma-separated.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
FRONTEND_BASE_URL=

# Conservative defaults for one application container and one MySQL container.
SQL_MAX_OPEN_CONNS=100
SQL_MAX_IDLE_CONNS=25
SQL_MAX_LIFETIME=60
REDIS_POOL_SIZE=20
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
STREAMING_TIMEOUT=300
